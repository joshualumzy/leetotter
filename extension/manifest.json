{
  "manifest_version": 3,
  "name": "Leetotter",
  "version": "0.1.0",
  "description": "Local companion status for Leetotter.",
  "key": "",
  "permissions": ["sidePanel", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "https://neetcode.io/*"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [
    { "matches": ["https://neetcode.io/*"], "js": ["page-reader.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://neetcode.io/*"], "js": ["page-bridge.js"], "world": "ISOLATED", "run_at": "document_start" }
  ],
  "side_panel": { "default_path": "panel.html" }
}
